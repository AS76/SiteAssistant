{
  "name": "siteassistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test tests/",
    "test:schema": "node tests/schema.test.mjs",
    "start": "node server/index.mjs",
    "seed": "node server/seed.mjs",
    "create-user": "node server/create-user.mjs",
    "test:pg": "DB_DRIVER=pg node --test tests/",
    "seed:demo": "node server/seed-demo.mjs --apply",
    "seed:demo:reset": "node server/seed-demo.mjs --reset",
    "dev": "SERVE_APP=1 NODE_ENV=development node server/index.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
