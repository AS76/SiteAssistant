---
import { resolve } from 'node:path';
import sharp from 'sharp';

// Screenshot used in the manual. `src` is the site-absolute path of the file in
// `public/`, for example `/images/2026-11/overview-desktop.png`; the component adds
// the Astro base path so the image resolves both on the project site and in dev.
interface Props {
  src: string;
  alt: string;
  caption?: string;
  width: number | string;
  height: number | string;
  compact?: boolean;
}

const { src, alt, caption, width, height, compact = false } = Astro.props;
const file = src.replace(/^\/+/, '');
const original = await sharp(resolve('public', file)).metadata();
if (Number(width) !== original.width || Number(height) !== original.height) {
  throw new Error(`Declare the original ${original.width} × ${original.height} dimensions for ${src}`);
}
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const url = `${base}/${file}`;
---

<figure class:list={['docs-shot', { compact }]}>
  <a href={url} target="_blank" rel="noopener">
    <img src={url} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .docs-shot {
    margin: 1.5rem 0;
  }

  .docs-shot a {
    display: block;
    width: fit-content;
    max-width: 100%;
  }

  .docs-shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }

  .docs-shot figcaption {
    margin-top: 0.55rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    line-height: 1.5;
  }

  .docs-shot.compact a {
    max-width: 320px;
    margin-inline: auto;
  }

  .docs-shot.compact figcaption {
    max-width: 420px;
    margin-inline: auto;
    text-align: center;
  }
</style>
